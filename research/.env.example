# Copy to research/.env and fill in. `.env` is gitignored; this file is not.
# The npm scripts load it via node --env-file-if-exists, so there is no dotenv
# dependency and CI still works from real environment variables with no file.

ANTHROPIC_API_KEY=

# Optional overrides, all documented in the header of each script.
# MIGAKI_ROOT=
# MIGAKI_RUN_DATE=2026-07-26
# MIGAKI_WINDOW_DAYS=7
# MIGAKI_MIN_DAYS_SEEN=2
