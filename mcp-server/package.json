{
  "name": "migaki-mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server exposing the migaki taste layer to AI coding agents",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch --preserveWatchOutput",
    "start": "node dist/index.js",
    "test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.9.3"
  }
}
